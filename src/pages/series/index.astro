---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageSidebar from '../../components/PageSidebar.astro';
import { compareSeriesPosts, getPostSeries, getPostUrl } from '../../lib/posts';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const seriesMeta: Record<string, { href: string; description: string; plannedCount?: number }> = {
  '从零看懂股票': {
    href: '/series/stock-basics/',
    description: '写给普通人的股票入门路径，从股票是什么开始，逐步理解行情、收益、财报与估值。',
    plannedCount: 10,
  },
  'A股科技与未来产业研究路线': {
    href: '/series/a-share-tech-research/',
    description: '按年度项目推进的 A 股科技与未来产业研究记录，从研究意义、财报练习、公司拆解到月度复盘。',
    plannedCount: 24,
  },
};
const seriesList = Array.from(
  posts.reduce((groups, post) => {
    const series = getPostSeries(post);
    if (!series) return groups;
    groups.set(series, [...(groups.get(series) ?? []), post]);
    return groups;
  }, new Map<string, typeof posts>())
).map(([series, items]) => {
  const sortedPosts = items.sort(compareSeriesPosts);
  const maxOrder = Math.max(...sortedPosts.map((post) => post.data.seriesOrder ?? 0), sortedPosts.length);
  const plannedCount = seriesMeta[series]?.plannedCount ?? maxOrder;
  return {
    title: series,
    href: seriesMeta[series]?.href ?? `/series/${encodeURIComponent(series)}/`,
    description: seriesMeta[series]?.description ?? '按顺序整理的一组系列文章。',
    posts: sortedPosts,
    plannedCount,
    progress: Math.min(sortedPosts.length / plannedCount, 1),
  };
});
---

<BaseLayout
  title="专题"
  description="按阅读路径组织的系列文章。"
  canonicalPath="/series/"
>
  <div class="page-grid">
    <div>
      <section class="hero">
        <p class="eyebrow">专题</p>
        <h1>按顺序阅读的内容路径</h1>
        <p class="lead">专题用于承载系列文章，比标签更强调阅读顺序和完整框架。</p>
      </section>

      <div class="series-overview-list">
        {
          seriesList.map((series) => (
            <article class="series-overview-card">
              <div class="series-overview-head">
                <div>
                  <p class="post-meta">{series.posts.length} / {series.plannedCount} 已完成</p>
                  <h2><a href={series.href}>{series.title}</a></h2>
                </div>
                <strong>{Math.round(series.progress * 100)}%</strong>
              </div>
              <div class="series-progress" aria-label={`${series.title} 完成进度 ${series.posts.length} / ${series.plannedCount}`}>
                <span style={`width: ${series.progress * 100}%`}></span>
              </div>
              <p>{series.description}</p>
              <ol class="series-mini-list">
                {series.posts.map((post) => (
                  <li>
                    <a href={getPostUrl(post)}>
                      {post.data.title}
                    </a>
                  </li>
                ))}
              </ol>
            </article>
          ))
        }
      </div>
    </div>

    <PageSidebar
      title="专题"
      intro="专题是长期内容的骨架，标签是具体主题的索引。"
      sections={[
        {
          title: '继续浏览',
          items: [
            { label: '全部文章', href: '/posts/' },
            { label: '标签：财报分析', href: '/tags/财报分析/' },
            { label: '研究方法', href: '/about/#method' },
          ],
        },
      ]}
    />
  </div>
</BaseLayout>
