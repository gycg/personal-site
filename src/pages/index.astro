---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION } from '../consts';
import PageSidebar from '../components/PageSidebar.astro';
import { comparePostsNewest, estimateReadingMinutes, getPostUrl } from '../lib/posts';

const allPosts = (await getCollection('posts', ({ data }) => !data.draft)).sort(comparePostsNewest);
const posts = allPosts.slice(0, 5);
const latestPost = posts[0];
const recentPosts = posts.slice(1);
const investmentCount = allPosts.filter((post) => post.data.tags.includes('投资研究')).length;
const stockBasicsCount = allPosts.filter((post) => post.data.series === '从零看懂股票').length;
const techResearchCount = allPosts.filter((post) => post.data.series === 'A股科技与未来产业研究路线').length;
const tagCount = new Set(allPosts.flatMap((post) => post.data.tags)).size;
const dateFormatter = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout description={SITE_DESCRIPTION}>
  <div class="page-grid home-grid">
    <div class="main-column">
      <section class="hero">
        <div class="home-masthead">
          <p class="eyebrow">长坡厚雪 · Research Notes</p>
          <p>Investment / LLM / Engineering</p>
        </div>
        <h1>一个程序员的长期研究博客</h1>
        <p class="lead">
          这里同时记录两条主线：用工程化方法研究股票、公司和长期资产积累；也沉淀 LLM 算法工程师视角下的大模型技术、工程实践与行业研究。
        </p>
        <div class="home-stats" aria-label="站点概览">
          <a href="/posts/">
            <strong>{allPosts.length}</strong>
            <span>公开文章</span>
          </a>
          <a href="/tags/投资研究/">
            <strong>{investmentCount}</strong>
            <span>投研文章</span>
          </a>
          <a href="/posts/">
            <strong>{tagCount}</strong>
            <span>研究标签</span>
          </a>
        </div>
      </section>

      <section class="content-section home-priority-section" aria-labelledby="latest-posts">
        <div class="section-head">
          <h2 id="latest-posts">最新研究</h2>
          <a href="/posts/">查看全部文章</a>
        </div>
        <div class="home-latest-grid">
          {
            latestPost && (
              <article class="home-featured-post">
                <p class="post-meta">{dateFormatter.format(latestPost.data.pubDate)} · 约 {estimateReadingMinutes(latestPost)} 分钟读完</p>
                <h3><a href={getPostUrl(latestPost)}>{latestPost.data.title}</a></h3>
                <p>{latestPost.data.description}</p>
                <div class="tags">
                  {latestPost.data.tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>{tag}</a>)}
                </div>
              </article>
            )
          }
          <div class="home-recent-list" aria-label="近期文章">
            {recentPosts.map((post, index) => (
              <article>
                <span>{String(index + 2).padStart(2, '0')}</span>
                <div>
                  <p class="post-meta">{dateFormatter.format(post.data.pubDate)}</p>
                  <h3><a href={getPostUrl(post)}>{post.data.title}</a></h3>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="content-section" aria-labelledby="reading-paths">
        <div class="section-head">
          <h2 id="reading-paths">专题路线</h2>
          <a href="/series/">查看全部专题</a>
        </div>
        <div class="home-route-list">
          <a href="/series/stock-basics/">
            <span>01</span>
            <div><strong>从零看懂股票</strong><p>股票、财报、商业模式与估值的顺序阅读路径。</p></div>
            <em>{stockBasicsCount} 篇</em>
          </a>
          <a href="/series/a-share-tech-research/">
            <span>02</span>
            <div><strong>A股科技与未来产业研究</strong><p>从公司研究进入产业、财务结构和竞争壁垒。</p></div>
            <em>{techResearchCount} 篇</em>
          </a>
        </div>
      </section>

      <section class="content-section" aria-labelledby="active-projects">
        <div class="section-head">
          <h2 id="active-projects">当前项目</h2>
          <a href="/projects/">查看全部项目</a>
        </div>
        <div class="home-project-links">
          <a href="/projects/holdings/"><span>Portfolio Tracker</span><strong>持仓复盘</strong><p>交易、成本、分拆和组合收益的持续记录。</p></a>
          <a href="/projects/a-share-sector-rotation/"><span>Market Monitor</span><strong>A股行业轮动</strong><p>观察行业强弱、热力和相对动量变化。</p></a>
          <a href="/projects/financial-freedom-roadmap/"><span>Execution System</span><strong>财务自由路线</strong><p>用阶段、规则和复盘验证长期投资能力。</p></a>
        </div>
      </section>
    </div>

    <PageSidebar
      title="站点导航"
      compact
      intro="先读最新研究，再沿专题深入；项目页保留正在运行的投资工具与执行记录。"
      sections={[
        {
          title: '建议顺序',
          items: [
            { label: '最新研究', href: '#latest-posts' },
            { label: '专题路线', href: '#reading-paths' },
            { label: '当前项目', href: '#active-projects' },
          ],
        },
        {
          title: '研究入口',
          items: [
            { label: '从零看懂股票', href: '/series/stock-basics/' },
            { label: 'A股科技研究', href: '/series/a-share-tech-research/' },
            { label: '全部投资研究', href: '/tags/投资研究/' },
            { label: '研究方法', href: '/about/#method' },
          ],
        },
        {
          title: '最近更新',
          items: posts.slice(0, 1).map((post) => ({
            label: post.data.title,
            href: getPostUrl(post),
          })),
        },
      ]}
    />
  </div>
</BaseLayout>
