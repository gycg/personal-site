<script define:vars={{ positions, activePositions, summary, trades, splitEvents, firstTradeDate, eastmoneySecids, tencentSymbols, targetAllocations, targetEastmoneySecids }}>
  const cashEventSides = new Set(['现金分红', '利息归本', '红利税补缴']);
  const copyTableButtons = document.querySelectorAll('[data-copy-table]');
  const copyPlainText = async (value) => {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(value);
      return;
    }

    const input = document.createElement('textarea');
    input.value = value;
    input.setAttribute('readonly', '');
    input.style.position = 'fixed';
    input.style.opacity = '0';
    document.body.append(input);
    input.select();
    document.execCommand('copy');
    input.remove();
  };

  copyTableButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const copyTableStatus = button.dataset.copyStatusId
        ? document.getElementById(button.dataset.copyStatusId)
        : null;

      try {
        await copyPlainText(button.dataset.copyValue || '');
        if (copyTableStatus) copyTableStatus.textContent = button.dataset.copySuccess || '已复制表格。';
      } catch {
        if (copyTableStatus) copyTableStatus.textContent = '复制失败，可以手动选中表格内容。';
      }
    });
  });

  function initCalendarPager() {
    const calendarRoot = document.querySelector('[data-calendar-root]');
    if (!calendarRoot) return;

    const months = Array.from(calendarRoot.querySelectorAll('[data-calendar-month]'));
    const label = calendarRoot.querySelector('[data-calendar-label]');
    const previous = calendarRoot.querySelector('[data-calendar-prev]');
    const next = calendarRoot.querySelector('[data-calendar-next]');
    if (!months.length || !label || !previous || !next) return;

    let current = months.findIndex((month) => !month.hidden);
    if (current < 0) current = Math.max(months.length - 1, 0);

    const renderCalendarMonth = () => {
      months.forEach((month, index) => {
        month.hidden = index !== current;
      });
      if (label) label.textContent = months[current]?.dataset.calendarLabel ?? '';
      if (previous) previous.disabled = current <= 0;
      if (next) next.disabled = current >= months.length - 1;
    };

    previous?.addEventListener('click', () => {
      current = Math.max(current - 1, 0);
      renderCalendarMonth();
    });
    next?.addEventListener('click', () => {
      current = Math.min(current + 1, months.length - 1);
      renderCalendarMonth();
    });
    renderCalendarMonth();
  }

  initCalendarPager();

  const currencyFormatter = new Intl.NumberFormat('zh-CN', {
    style: 'currency',
    currency: 'CNY',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
  const priceFormatter = new Intl.NumberFormat('zh-CN', {
    minimumFractionDigits: 3,
    maximumFractionDigits: 3,
  });
  const percentFormatter = new Intl.NumberFormat('zh-CN', {
    style: 'percent',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
  const compactCurrencyFormatter = new Intl.NumberFormat('zh-CN', {
    style: 'currency',
    currency: 'CNY',
    notation: 'compact',
    maximumFractionDigits: 2,
  });
  const weekdayLabels = ['一', '二', '三', '四', '五', '六', '日'];
  const positionById = new Map(positions.map((position) => [position.id, position]));
  let browserDailyPoints = [];
  let latestLiveQuotes = [];

  const intradayRoot = document.querySelector('[data-intraday-root]');
  const intradayRefresh = document.querySelector('[data-intraday-refresh]');
  const intradayChart = document.querySelector('[data-intraday-chart]');
  const intradayChartWrap = document.querySelector('[data-intraday-chart-wrap]');
  const intradayTooltip = document.querySelector('[data-intraday-tooltip]');
  const intradayEmpty = document.querySelector('[data-intraday-empty]');
  const svgNamespace = 'http://www.w3.org/2000/svg';
  let intradayPoints = [];
  let intradayChartGeometry = null;
  let intradayFocusIndex = -1;
  let intradayRequest = null;

  function setIntradayText(selector, value) {
    const element = intradayRoot?.querySelector(selector);
    if (element) element.textContent = value;
  }

  function createSvgElement(tag, attributes = {}) {
    const element = document.createElementNS(svgNamespace, tag);
    Object.entries(attributes).forEach(([name, value]) => element.setAttribute(name, String(value)));
    return element;
  }

  function clearSvgGroup(selector) {
    const group = intradayChart?.querySelector(selector);
    if (group) group.replaceChildren();
    return group;
  }

  function getShanghaiClock() {
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'Asia/Shanghai',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
      weekday: 'short',
      hour: '2-digit',
      minute: '2-digit',
      hourCycle: 'h23',
    }).formatToParts(new Date());
    const values = Object.fromEntries(parts.map((part) => [part.type, part.value]));
    return {
      date: `${values.year}-${values.month}-${values.day}`,
      weekday: values.weekday,
      minutes: Number(values.hour) * 60 + Number(values.minute),
    };
  }

  function isShanghaiTradingTime() {
    const clock = getShanghaiClock();
    if (['Sat', 'Sun'].includes(clock.weekday)) return false;
    return (clock.minutes >= 570 && clock.minutes <= 695) || (clock.minutes >= 775 && clock.minutes <= 905);
  }

  function normalizeSinaIntradayPayload(payload, position) {
    if (!Array.isArray(payload) || !payload.length) return null;
    const normalized = payload.map((row) => ({
      timestamp: row.day,
      date: row.day?.slice(0, 10),
      time: row.day?.slice(11, 16),
      open: Number(row.open),
      close: Number(row.close),
      high: Number(row.high),
      low: Number(row.low),
      volume: Number(row.volume) / 100,
      amount: Number(row.amount),
    })).filter((point) => point.timestamp && Object.values(point).slice(3).every(Number.isFinite));
    if (!normalized.length) return null;

    const latestDate = normalized.at(-1).date;
    const latestRows = normalized.filter((point) => point.date === latestDate);
    const previousRows = normalized.filter((point) => point.date < latestDate);
    const previousClose = previousRows.at(-1)?.close ?? latestRows[0]?.open;
    let cumulativeVolume = 0;
    let cumulativeAmount = 0;
    const rows = latestRows.map((point) => {
      cumulativeVolume += point.volume * 100;
      cumulativeAmount += point.amount;
      return {
        ...point,
        average: cumulativeVolume > 0 ? cumulativeAmount / cumulativeVolume : point.close,
      };
    });

    return rows.length ? {
      position,
      code: position.code,
      name: position.name,
      previousClose,
      source: '新浪公开行情接口',
      rows,
    } : null;
  }

  function loadSinaIntraday(position, signal) {
    return new Promise((resolve, reject) => {
      const callbackName = `_intradayKline_${Date.now()}_${Math.floor(Math.random() * 10000)}`;
      const script = document.createElement('script');
      let settled = false;
      const cleanup = () => {
        script.remove();
        try { delete window[callbackName]; } catch { window[callbackName] = undefined; }
      };
      const finish = (callback, value) => {
        if (settled) return;
        settled = true;
        cleanup();
        callback(value);
      };
      const abort = () => finish(reject, new DOMException('Request aborted', 'AbortError'));
      signal.addEventListener('abort', abort, { once: true });
      script.async = true;
      script.src = `https://quotes.sina.cn/cn/api/jsonp_v2.php/var%20${callbackName}=/CN_MarketDataService.getKLineData?symbol=${position.quoteSymbol}&scale=1&ma=no&datalen=500&_=${Date.now()}`;
      script.onload = () => {
        signal.removeEventListener('abort', abort);
        const data = normalizeSinaIntradayPayload(window[callbackName], position);
        data ? finish(resolve, data) : finish(reject, new Error('Sina minute quote response is empty'));
      };
      script.onerror = () => {
        signal.removeEventListener('abort', abort);
        finish(reject, new Error('Sina minute quote script failed'));
      };
      document.head.append(script);
    });
  }

  function aggregateIntradayGroups(groups) {
    if (groups.length !== activePositions.length) {
      throw new Error(`Only ${groups.length} of ${activePositions.length} positions returned minute data`);
    }

    const latestDate = groups.map((group) => group.rows.at(-1)?.date).filter(Boolean).sort().at(-1);
    const currentGroups = groups.filter((group) => group.rows.at(-1)?.date === latestDate);
    if (!latestDate || currentGroups.length !== activePositions.length) {
      throw new Error('Position minute data is not from the same trading day');
    }

    const times = [...new Set(currentGroups.flatMap((group) => group.rows.map((point) => point.time)))].sort();
    const state = currentGroups.map((group) => ({
      group,
      byTime: new Map(group.rows.map((point) => [point.time, point])),
      previous: group.previousClose,
    }));
    const rows = times.map((time) => {
      const aggregate = {
        timestamp: `${latestDate} ${time}`,
        date: latestDate,
        time,
        open: 0,
        close: 0,
        high: 0,
        low: 0,
        volume: 0,
        amount: 0,
        average: 0,
      };

      state.forEach((item) => {
        const point = item.byTime.get(time);
        const fallback = item.previous;
        const quantity = item.group.position.quantity;
        aggregate.open += (point?.open ?? fallback) * quantity;
        aggregate.close += (point?.close ?? fallback) * quantity;
        aggregate.high += (point?.high ?? fallback) * quantity;
        aggregate.low += (point?.low ?? fallback) * quantity;
        aggregate.average += (point?.average ?? fallback) * quantity;
        aggregate.volume += point?.volume ?? 0;
        aggregate.amount += point?.amount ?? 0;
        if (point) item.previous = point.close;
      });
      return aggregate;
    });

    return {
      code: `${activePositions.length} 只当前持仓`,
      name: '持仓组合',
      previousClose: currentGroups.reduce((sum, group) => sum + group.previousClose * group.position.quantity, 0),
      source: '新浪公开行情接口',
      rows,
    };
  }

  function renderIntradayFocus(index, pointerX = null) {
    if (!intradayChartGeometry || !intradayPoints.length || !intradayTooltip) return;
    const safeIndex = Math.max(0, Math.min(index, intradayPoints.length - 1));
    const point = intradayPoints[safeIndex];
    const { xAt, yAt, priceTop, volumeBottom } = intradayChartGeometry;
    const x = xAt(safeIndex);
    const y = yAt(point.close);
    const focus = intradayChart.querySelector('[data-intraday-focus]');
    const [vertical, horizontal, dot] = focus.children;
    vertical.setAttribute('x1', x);
    vertical.setAttribute('x2', x);
    vertical.setAttribute('y1', priceTop);
    vertical.setAttribute('y2', volumeBottom);
    horizontal.setAttribute('x1', 56);
    horizontal.setAttribute('x2', 942);
    horizontal.setAttribute('y1', y);
    horizontal.setAttribute('y2', y);
    dot.setAttribute('cx', x);
    dot.setAttribute('cy', y);
    focus.style.display = '';

    const directionClass = point.close >= point.open ? 'is-up' : 'is-down';
    intradayTooltip.className = `intraday-tooltip ${directionClass}`;
    intradayTooltip.innerHTML = `<strong>${point.time} · ${currencyFormatter.format(point.close)}</strong><span>开 ${currencyFormatter.format(point.open)}　高 ${currencyFormatter.format(point.high)}</span><span>低 ${currencyFormatter.format(point.low)}　成交额 ${compactCurrencyFormatter.format(point.amount)}</span>`;
    intradayTooltip.hidden = false;
    const wrapWidth = intradayChartWrap?.clientWidth ?? 0;
    const scaledX = pointerX ?? (x / 960) * wrapWidth;
    intradayTooltip.style.left = `${Math.max(8, Math.min(scaledX, wrapWidth - 8))}px`;
    intradayTooltip.classList.toggle('is-left', scaledX > wrapWidth * 0.62);
    intradayFocusIndex = safeIndex;
  }

  function hideIntradayFocus() {
    const focus = intradayChart?.querySelector('[data-intraday-focus]');
    if (focus) focus.style.display = 'none';
    if (intradayTooltip) intradayTooltip.hidden = true;
  }

  function renderIntradayChart(data) {
    const rows = data.rows;
    const previousClose = Number.isFinite(data.previousClose) ? data.previousClose : rows[0].open;
    const grid = clearSvgGroup('[data-intraday-grid]');
    const volumeBars = clearSvgGroup('[data-intraday-volume-bars]');
    const candles = clearSvgGroup('[data-intraday-candles]');
    const axis = clearSvgGroup('[data-intraday-axis]');
    const averageLine = intradayChart.querySelector('[data-intraday-average]');
    const previousLine = intradayChart.querySelector('[data-intraday-previous]');
    const priceLeft = 56;
    const priceRight = 942;
    const priceTop = 20;
    const priceBottom = 274;
    const volumeTop = 306;
    const volumeBottom = 365;
    const rawMin = Math.min(previousClose, ...rows.map((point) => point.low));
    const rawMax = Math.max(previousClose, ...rows.map((point) => point.high));
    const pricePadding = Math.max((rawMax - rawMin) * 0.08, previousClose * 0.002);
    const minPrice = rawMin - pricePadding;
    const maxPrice = rawMax + pricePadding;
    const maxAmount = Math.max(...rows.map((point) => point.amount), 1);
    const xAt = (index) => priceLeft + (index / Math.max(rows.length - 1, 1)) * (priceRight - priceLeft);
    const yAt = (price) => priceBottom - ((price - minPrice) / (maxPrice - minPrice)) * (priceBottom - priceTop);
    const candleWidth = Math.max(1.3, Math.min(4.2, ((priceRight - priceLeft) / rows.length) * 0.68));

    for (let index = 0; index < 5; index += 1) {
      const ratio = index / 4;
      const y = priceTop + ratio * (priceBottom - priceTop);
      grid.append(createSvgElement('line', { class: 'intraday-grid-line', x1: priceLeft, x2: priceRight, y1: y, y2: y }));
      const value = maxPrice - ratio * (maxPrice - minPrice);
      const label = createSvgElement('text', { class: 'intraday-y-label', x: priceLeft - 8, y: y + 4, 'text-anchor': 'end' });
      label.textContent = compactCurrencyFormatter.format(value);
      axis.append(label);
    }

    const preferredTimes = ['09:30', '10:30', '11:30', '14:00', '15:00'];
    preferredTimes.forEach((time) => {
      const index = rows.findIndex((point) => point.time === time);
      if (index < 0) return;
      const x = xAt(index);
      grid.append(createSvgElement('line', { class: 'intraday-grid-line is-vertical', x1: x, x2: x, y1: priceTop, y2: volumeBottom }));
      const label = createSvgElement('text', { class: 'intraday-x-label', x, y: 392, 'text-anchor': index === 0 ? 'start' : index === rows.length - 1 ? 'end' : 'middle' });
      label.textContent = time;
      axis.append(label);
    });

    rows.forEach((point, index) => {
      const x = xAt(index);
      const isUp = point.close >= point.open;
      const className = isUp ? 'is-up' : 'is-down';
      candles.append(createSvgElement('line', {
        class: `intraday-wick ${className}`,
        x1: x,
        x2: x,
        y1: yAt(point.high),
        y2: yAt(point.low),
      }));
      const bodyTop = Math.min(yAt(point.open), yAt(point.close));
      const bodyHeight = Math.max(Math.abs(yAt(point.open) - yAt(point.close)), 1.1);
      candles.append(createSvgElement('rect', {
        class: `intraday-candle ${className}`,
        x: x - candleWidth / 2,
        y: bodyTop,
        width: candleWidth,
        height: bodyHeight,
      }));
      const volumeHeight = (point.amount / maxAmount) * (volumeBottom - volumeTop);
      volumeBars.append(createSvgElement('rect', {
        class: `intraday-volume-bar ${className}`,
        x: x - candleWidth / 2,
        y: volumeBottom - volumeHeight,
        width: candleWidth,
        height: Math.max(volumeHeight, 0.5),
      }));
    });

    averageLine.setAttribute('points', rows.map((point, index) => `${xAt(index)},${yAt(point.average)}`).join(' '));
    const previousY = yAt(previousClose);
    Object.entries({ x1: priceLeft, x2: priceRight, y1: previousY, y2: previousY }).forEach(([name, value]) => previousLine.setAttribute(name, value));
    intradayPoints = rows;
    intradayChartGeometry = { xAt, yAt, priceLeft, priceRight, priceTop, volumeBottom };
    intradayFocusIndex = rows.length - 1;
    intradayEmpty.hidden = true;
    window.portfolioGifData = {
      name: data.name,
      positionCount: activePositions.length,
      source: data.source,
      previousClose,
      rows: rows.map((point) => ({
        date: point.date,
        time: point.time,
        open: point.open,
        close: point.close,
        high: point.high,
        low: point.low,
        amount: point.amount,
        average: point.average,
      })),
    };
    const downloadButton = document.querySelector('[data-intraday-download]');
    if (downloadButton) downloadButton.disabled = false;
  }

  function renderIntradaySummary(data) {
    const first = data.rows[0];
    const last = data.rows.at(-1);
    const previousClose = Number.isFinite(data.previousClose) ? data.previousClose : first.open;
    const changeAmount = last.close - previousClose;
    const changeRate = changeAmount / previousClose;
    const isCurrentDay = last.date === getShanghaiClock().date;
    setIntradayText('[data-intraday-code]', data.code);
    setIntradayText('[data-intraday-name]', data.name);
    setIntradayText('[data-intraday-status]', `${isCurrentDay ? '今日' : '最近交易日'} ${last.date} · 更新至 ${last.time} · 已汇总全部持仓`);
    setIntradayText('[data-intraday-latest]', currencyFormatter.format(last.close));
    setIntradayText('[data-intraday-change]', `${changeAmount >= 0 ? '+' : ''}${currencyFormatter.format(changeAmount)}`);
    setIntradayText('[data-intraday-change-rate]', `${changeRate >= 0 ? '+' : ''}${percentFormatter.format(changeRate)}`);
    setIntradayText('[data-intraday-open]', currencyFormatter.format(first.open));
    setIntradayText('[data-intraday-high]', currencyFormatter.format(Math.max(...data.rows.map((point) => point.high))));
    setIntradayText('[data-intraday-low]', currencyFormatter.format(Math.min(...data.rows.map((point) => point.low))));
    setIntradayText('[data-intraday-source]', data.source);
    intradayRoot.classList.toggle('is-up', changeAmount >= 0);
    intradayRoot.classList.toggle('is-down', changeAmount < 0);
  }

  async function loadIntradayChart() {
    if (!intradayRoot || !intradayChart || !activePositions.length) return;
    intradayRequest?.abort();
    const controller = new AbortController();
    intradayRequest = controller;
    const timeout = setTimeout(() => controller.abort(), 7000);
    intradayRoot.setAttribute('aria-busy', 'true');
    intradayRefresh.disabled = true;
    intradayRefresh.classList.add('is-loading');
    intradayEmpty.hidden = false;
    intradayEmpty.textContent = '正在读取分钟数据...';
    setIntradayText('[data-intraday-code]', `${activePositions.length} 只当前持仓`);
    setIntradayText('[data-intraday-name]', '持仓组合');
    setIntradayText('[data-intraday-status]', '正在读取分钟数据...');

    try {
      const groups = await Promise.all(activePositions.map((position) => loadSinaIntraday(position, controller.signal)));
      const data = aggregateIntradayGroups(groups);
      renderIntradaySummary(data);
      renderIntradayChart(data);
    } catch (error) {
      if (controller.signal.aborted && intradayRequest !== controller) return;
      console.warn('Portfolio minute chart failed', error);
      setIntradayText('[data-intraday-status]', '组合分钟行情加载失败');
      intradayEmpty.hidden = false;
      intradayEmpty.textContent = '未能取得全部持仓的同日分钟行情，请稍后刷新。';
    } finally {
      clearTimeout(timeout);
      if (intradayRequest === controller) {
        intradayRoot.setAttribute('aria-busy', 'false');
        intradayRefresh.disabled = false;
        intradayRefresh.classList.remove('is-loading');
      }
    }
  }

  intradayRefresh?.addEventListener('click', loadIntradayChart);
  intradayChart?.addEventListener('pointermove', (event) => {
    if (!intradayChartGeometry || !intradayPoints.length) return;
    const bounds = intradayChart.getBoundingClientRect();
    const pointerX = event.clientX - bounds.left;
    const svgX = (pointerX / bounds.width) * 960;
    const ratio = (svgX - intradayChartGeometry.priceLeft) / (intradayChartGeometry.priceRight - intradayChartGeometry.priceLeft);
    renderIntradayFocus(Math.round(ratio * (intradayPoints.length - 1)), pointerX);
  });
  intradayChart?.addEventListener('pointerleave', hideIntradayFocus);
  intradayChart?.addEventListener('focus', () => renderIntradayFocus(intradayFocusIndex < 0 ? intradayPoints.length - 1 : intradayFocusIndex));
  intradayChart?.addEventListener('blur', hideIntradayFocus);
  intradayChart?.addEventListener('keydown', (event) => {
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key) || !intradayPoints.length) return;
    event.preventDefault();
    if (event.key === 'Home') intradayFocusIndex = 0;
    if (event.key === 'End') intradayFocusIndex = intradayPoints.length - 1;
    if (event.key === 'ArrowLeft') intradayFocusIndex = Math.max(0, intradayFocusIndex - 1);
    if (event.key === 'ArrowRight') intradayFocusIndex = Math.min(intradayPoints.length - 1, intradayFocusIndex + 1);
    renderIntradayFocus(intradayFocusIndex);
  });

  loadIntradayChart();
  window.setInterval(() => {
    if (!document.hidden && isShanghaiTradingTime()) loadIntradayChart();
  }, 60_000);

  function getTradeDate(trade) {
    return trade.executedAt.slice(0, 10);
  }

  function normalizeBrowserKlinePayload(payload, position, adjustment = 'raw') {
    const data = payload.data;
    if (!data?.klines?.length) return null;

    const symbol = `${Number(data.market) === 1 ? 'sh' : 'sz'}${data.code}`;
    const rows = data.klines
      .map((line) => {
        const parts = line.split(',');
        const close = Number(parts[2]);
        return parts[0] && Number.isFinite(close) ? { date: parts[0], close } : null;
      })
      .filter(Boolean);

    if (!rows.length) return null;
    return adjustment === 'qfq'
      ? { securityId: position.id, symbol, rows: [], qfqRows: rows }
      : { securityId: position.id, symbol, rows };
  }

  function normalizeBrowserTencentKlinePayload(payload, position) {
    const rows = payload.data?.[position.quoteSymbol]?.day ?? payload.data?.[position.quoteSymbol]?.qfqday ?? [];
    const normalizedRows = rows
      .map((row) => {
        const close = Number(row[2]);
        return row[0] && Number.isFinite(close) ? { date: row[0], close } : null;
      })
      .filter(Boolean);

    return normalizedRows.length ? { securityId: position.id, symbol: position.quoteSymbol, rows: normalizedRows } : null;
  }

  async function loadBrowserKlineGroup(position) {
    const marketPrefix = position.market === 'sh' ? '1' : '0';
    const fields1 = 'f1,f2,f3,f4,f5,f6';
    const fields2 = 'f51,f52,f53,f54,f55,f56,f57,f58,f59,f60,f61';
    const makeUrl = (fqt) => `https://push2his.eastmoney.com/api/qt/stock/kline/get?secid=${marketPrefix}.${position.code}&fields1=${fields1}&fields2=${fields2}&klt=101&fqt=${fqt}&beg=${firstTradeDate}&end=20500101`;
    const start = getTradeDate([...trades].sort((a, b) => a.executedAt.localeCompare(b.executedAt))[0]);
    const tencentUrl = `https://web.ifzq.gtimg.cn/appstock/app/fqkline/get?param=${position.quoteSymbol},day,${start},2050-01-01,1600`;

    try {
      const response = await fetch(`${tencentUrl}&_=${Date.now()}`, { cache: 'no-store' });
      if (response.ok) {
        const kline = normalizeBrowserTencentKlinePayload(await response.json(), position);
        if (kline) return kline;
      }
    } catch (error) {
      console.warn(`Tencent kline failed for ${position.code}`, error);
    }

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 5000);
    try {
      const response = await fetch(`${makeUrl(0)}&_=${Date.now()}`, { cache: 'no-store', signal: controller.signal });
      if (!response.ok) return null;
      const kline = normalizeBrowserKlinePayload(await response.json(), position);
      if (!kline) return null;

      try {
        const qfqResponse = await fetch(`${makeUrl(1)}&_=${Date.now()}`, { cache: 'no-store' });
        if (qfqResponse.ok) {
          const qfqKline = normalizeBrowserKlinePayload(await qfqResponse.json(), position, 'qfq');
          kline.qfqRows = qfqKline?.qfqRows ?? [];
        }
      } catch (error) {
        console.warn(`Eastmoney qfq kline failed for ${position.code}`, error);
      }

      return kline;
    } catch (error) {
      console.warn(`Eastmoney kline failed for ${position.code}`, error);
      return null;
    } finally {
      clearTimeout(timeout);
    }
  }

  function calculateBrowserDailyPoints(klineGroups) {
    const klineBySymbol = new Map(klineGroups.map((group) => [group.symbol, group.rows]));
    const allDates = [...new Set(klineGroups.flatMap((group) => group.rows.map((row) => row.date)))].sort();
    const sortedTrades = [...trades].sort((a, b) => a.executedAt.localeCompare(b.executedAt));
    const stateById = new Map(positions.map((position) => [position.id, { quantity: 0, cost: 0, realizedProfit: 0 }]));
    const splitEventsByDate = new Map();
    for (const event of splitEvents) {
      const events = splitEventsByDate.get(event.date) ?? [];
      events.push(event);
      splitEventsByDate.set(event.date, events);
    }
    const splitSecurityIds = new Set(splitEvents.map((event) => event.securityId));
    const latestCloseBySymbol = new Map();
    let tradeIndex = 0;
    let previousProfit = null;

    return allDates.map((date) => {
      for (const [symbol, rows] of klineBySymbol.entries()) {
        const row = rows.find((item) => item.date === date);
        if (row) latestCloseBySymbol.set(symbol, row.close);
      }

      for (const event of splitEventsByDate.get(date) ?? []) {
        const state = stateById.get(event.securityId);
        if (state) state.quantity *= event.ratio;
      }

      while (tradeIndex < sortedTrades.length && getTradeDate(sortedTrades[tradeIndex]) <= date) {
        const trade = sortedTrades[tradeIndex];
        const state = stateById.get(trade.securityId);

        if (state) {
          if (trade.side === '买入') {
            state.quantity += trade.quantity;
            state.cost += trade.amount + trade.fee;
          } else if (trade.side === '红股入账') {
            if (!splitSecurityIds.has(trade.securityId)) state.quantity += trade.quantity;
          } else if (cashEventSides.has(trade.side)) {
            state.realizedProfit += trade.amount;
          } else {
            const averageCost = state.quantity > 0 ? state.cost / state.quantity : 0;
            const closingCost = averageCost * trade.quantity;
            state.quantity -= trade.quantity;
            state.cost -= closingCost;
            state.realizedProfit += trade.amount - trade.fee - (trade.tax ?? 0) - closingCost;
          }
        }

        tradeIndex += 1;
      }

      let marketValue = 0;
      let cost = 0;
      let realizedProfit = 0;

      for (const position of positions) {
        const state = stateById.get(position.id);
        const close = latestCloseBySymbol.get(position.quoteSymbol);
        if (!state || !close) continue;

        marketValue += state.quantity * close;
        cost += state.cost;
        realizedProfit += state.realizedProfit;
      }

      if (marketValue <= 0 && cost <= 0) return null;

      const profit = marketValue - cost + realizedProfit;
      const dailyChange = previousProfit === null ? 0 : profit - previousProfit;
      previousProfit = profit;

      return {
        date,
        profit,
        dailyChange,
        trades: sortedTrades.filter((trade) => getTradeDate(trade) === date),
      };
    }).filter(Boolean);
  }

  function getBrowserDailyTradeSummary(point) {
    if (!point.trades.length) return '无交易';

    return point.trades
      .map((trade) => {
        const position = positionById.get(trade.securityId);
        if (cashEventSides.has(trade.side)) return `${position?.name ?? ''}${trade.side} ${currencyFormatter.format(trade.amount)}`;
        return `${trade.side}${position?.name ?? ''} ${trade.quantity.toLocaleString('zh-CN')}份`;
      })
      .join(' / ');
  }

  function createCalendarDay(cell) {
    const article = document.createElement('article');
    article.className = 'holding-calendar-day';

    if (!cell.point) article.classList.add('is-muted');
    if (cell.point?.dailyChange >= 0) article.classList.add('is-profit');
    if (cell.point?.dailyChange < 0) article.classList.add('is-loss');
    if (cell.point?.trades.length) article.classList.add('has-trade');

    const time = document.createElement('time');
    time.dateTime = cell.date;
    time.textContent = String(cell.day);
    article.append(time);

    if (!cell.point) {
      const empty = document.createElement('span');
      empty.textContent = '--';
      article.append(empty);
      return article;
    }

    const change = document.createElement('strong');
    change.textContent = `${cell.point.dailyChange >= 0 ? '+' : ''}${currencyFormatter.format(cell.point.dailyChange)}`;
    article.append(change);

    const profit = document.createElement('span');
    profit.textContent = currencyFormatter.format(cell.point.profit);
    article.append(profit);

    const tradesLabel = document.createElement('p');
    tradesLabel.textContent = getBrowserDailyTradeSummary(cell.point);
    article.append(tradesLabel);

    return article;
  }

  function renderBrowserCalendar(points) {
    const calendarRoot = document.querySelector('[data-calendar-root]');
    if (!calendarRoot || !points.length) return;

    const pointByDate = new Map(points.map((point) => [point.date, point]));
    const start = new Date(`${points[0].date}T00:00:00`);
    const end = new Date(`${points.at(-1).date}T00:00:00`);
    const months = [];
    const cursor = new Date(start.getFullYear(), start.getMonth(), 1);

    while (cursor <= end) {
      const year = cursor.getFullYear();
      const month = cursor.getMonth();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const leadingBlanks = (new Date(year, month, 1).getDay() + 6) % 7;
      const cells = [
        ...Array.from({ length: leadingBlanks }, () => ({ isBlank: true })),
        ...Array.from({ length: daysInMonth }, (_, index) => {
          const day = index + 1;
          const date = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
          return { day, date, point: pointByDate.get(date), isBlank: false };
        }),
      ];

      months.push({ label: `${year}年${month + 1}月`, cells });
      cursor.setMonth(cursor.getMonth() + 1);
    }

    calendarRoot.replaceChildren();
    const toolbar = document.createElement('div');
    toolbar.className = 'holding-calendar-toolbar';
    toolbar.innerHTML = '<button type="button" data-calendar-prev aria-label="上一个月">‹</button><strong data-calendar-label></strong><button type="button" data-calendar-next aria-label="下一个月">›</button>';
    calendarRoot.append(toolbar);

    const pages = document.createElement('div');
    pages.className = 'holding-calendar-pages';
    pages.setAttribute('aria-live', 'polite');

    months.forEach((month, index) => {
      const monthElement = document.createElement('article');
      monthElement.className = 'holding-calendar-month';
      monthElement.dataset.calendarMonth = '';
      monthElement.dataset.calendarLabel = month.label;
      monthElement.hidden = index !== months.length - 1;

      const heading = document.createElement('h3');
      heading.textContent = month.label;
      monthElement.append(heading);

      const weekdays = document.createElement('div');
      weekdays.className = 'holding-calendar-weekdays';
      weekdays.setAttribute('aria-hidden', 'true');
      weekdayLabels.forEach((label) => {
        const span = document.createElement('span');
        span.textContent = label;
        weekdays.append(span);
      });
      monthElement.append(weekdays);

      const grid = document.createElement('div');
      grid.className = 'holding-calendar-grid';
      month.cells.forEach((cell) => {
        if (cell.isBlank) {
          const blank = document.createElement('div');
          blank.className = 'holding-calendar-day is-empty';
          blank.setAttribute('aria-hidden', 'true');
          grid.append(blank);
          return;
        }
        grid.append(createCalendarDay(cell));
      });
      monthElement.append(grid);
      pages.append(monthElement);
    });

    calendarRoot.append(pages);
    initCalendarPager();
  }

  function mergeLiveQuotesIntoCalendar(quotes) {
    if (!browserDailyPoints.length || quotes.length < activePositions.length) return false;

    const quoteBySymbol = new Map(quotes.map((quote) => [quote.symbol, quote]));
    const liveDate = quotes
      .map((quote) => quote.updatedAt?.slice(0, 10))
      .filter((date) => /^\d{4}-\d{2}-\d{2}$/.test(date))
      .sort()
      .at(-1);
    if (!liveDate) return false;

    let marketValue = 0;
    for (const position of activePositions) {
      const quote = quoteBySymbol.get(position.quoteSymbol);
      if (!quote?.price) return false;
      marketValue += quote.price * position.quantity;
    }

    const profit = marketValue - summary.totalCost + summary.realizedProfit;
    const points = [...browserDailyPoints];
    const latestPoint = points.at(-1);
    const replacingLatest = latestPoint?.date === liveDate;
    const previousPoint = replacingLatest ? points.at(-2) : latestPoint;
    const livePoint = {
      date: liveDate,
      profit,
      dailyChange: previousPoint ? profit - previousPoint.profit : 0,
      trades: trades.filter((trade) => getTradeDate(trade) === liveDate),
    };

    if (replacingLatest) points[points.length - 1] = livePoint;
    else if (!latestPoint || liveDate > latestPoint.date) points.push(livePoint);
    else return false;

    renderBrowserCalendar(points);
    return true;
  }

  async function refreshDailyCalendar() {
    const status = document.querySelector('[data-calendar-status]');

    try {
      const groups = (await Promise.all(positions.map(loadBrowserKlineGroup))).filter(Boolean);
      if (!groups.length) throw new Error('No browser kline data returned');

      const points = calculateBrowserDailyPoints(groups);
      if (!points.length) throw new Error('No daily portfolio points calculated');

      browserDailyPoints = points;
      const hasLivePoint = mergeLiveQuotesIntoCalendar(latestLiveQuotes);
      if (!hasLivePoint) renderBrowserCalendar(points);
      if (status) status.textContent = `已刷新至 ${(hasLivePoint ? latestLiveQuotes.map((quote) => quote.updatedAt?.slice(0, 10)).sort().at(-1) : points.at(-1).date)}`;
    } catch (error) {
      console.warn(error);
      if (status) status.textContent = '实时刷新失败，当前展示构建时快照';
    }
  }

  function setText(selector, value) {
    const element = document.querySelector(selector);
    if (element) element.textContent = value;
  }

  function setStatus(message) {
    setText('[data-quote-status]', message);
  }

  function updateQuoteTime(quotes) {
    const timeElement = document.querySelector('[data-quote-time]');
    if (!timeElement) return;

    const latest = quotes.map((quote) => quote.updatedAt).filter(Boolean).sort().at(-1);
    if (!latest) {
      timeElement.textContent = '行情时间 --';
      return;
    }

    timeElement.textContent = `行情时间 ${latest}`;
    timeElement.setAttribute('datetime', latest.replace(' ', 'T'));
  }

  function formatEastmoneyTime(timestamp) {
    if (!Number.isFinite(timestamp) || timestamp <= 0) return '';

    const date = new Date(timestamp * 1000);
    const pad = (value) => String(value).padStart(2, '0');
    return [
      date.getFullYear(),
      pad(date.getMonth() + 1),
      pad(date.getDate()),
    ].join('-') + ' ' + [
      pad(date.getHours()),
      pad(date.getMinutes()),
      pad(date.getSeconds()),
    ].join(':');
  }

  function normalizeEastmoneyQuote(item) {
    const price = Number(item.f2);
    if (!Number.isFinite(price) || price <= 0) return null;

    const market = String(item.f13) === '1' ? 'sh' : 'sz';
    return {
      symbol: `${market}${item.f12}`,
      name: item.f14,
      price,
      previousClose: Number(item.f18),
      scale: Number(item.f116),
      updatedAt: formatEastmoneyTime(Number(item.f124)),
    };
  }

  function parseTencentQuote(symbol) {
    const raw = window[`v_${symbol}`];
    if (!raw) return null;

    const parts = raw.split('~');
    const price = Number(parts[3]);
    if (!Number.isFinite(price) || price <= 0) return null;

    const timeRaw = parts[30] ?? '';
    const updatedAt = /^\d{14}$/.test(timeRaw)
      ? `${timeRaw.slice(0, 4)}-${timeRaw.slice(4, 6)}-${timeRaw.slice(6, 8)} ${timeRaw.slice(8, 10)}:${timeRaw.slice(10, 12)}:${timeRaw.slice(12, 14)}`
      : '';

    return {
      symbol,
      name: parts[1],
      price,
      previousClose: Number(parts[4]),
      updatedAt,
    };
  }

  function renderHoldings(quotes) {
    latestLiveQuotes = quotes;
    const quoteBySymbol = new Map(quotes.map((quote) => [quote.symbol, quote]));
    let totalMarketValue = 0;
    let hasAllQuotes = true;
    let returnedQuoteCount = 0;

    for (const position of activePositions) {
      const row = document.querySelector(`[data-position-row][data-symbol="${position.quoteSymbol}"]`);
      if (!row) continue;

      const quote = quoteBySymbol.get(position.quoteSymbol);
      if (!quote) {
        hasAllQuotes = false;
        continue;
      }

      returnedQuoteCount += 1;
      const marketValue = quote.price * position.quantity;
      const profit = marketValue - position.cost;
      const profitRate = position.cost > 0 ? profit / position.cost : 0;
      totalMarketValue += marketValue;

      row.querySelector('[data-current-price]').textContent = priceFormatter.format(quote.price);
      row.querySelector('[data-market-value]').textContent = currencyFormatter.format(marketValue);
      row.querySelector('[data-profit]').textContent = currencyFormatter.format(profit);
      row.querySelector('[data-profit-rate]').textContent = percentFormatter.format(profitRate);
      row.classList.toggle('is-profit', profit >= 0);
      row.classList.toggle('is-loss', profit < 0);

      const visualCard = document.querySelector(`[data-position-visual][data-symbol="${position.quoteSymbol}"]`);
      if (visualCard) {
        visualCard.querySelector('[data-chart-price]').textContent = priceFormatter.format(quote.price);
        visualCard.querySelector('[data-chart-market-value]').textContent = currencyFormatter.format(marketValue);
        visualCard.querySelector('[data-chart-profit]').textContent = currencyFormatter.format(profit);
        visualCard.querySelector('[data-chart-profit-rate]').textContent = `盈亏 ${percentFormatter.format(profitRate)}`;
        visualCard.classList.toggle('is-profit', profit >= 0);
        visualCard.classList.toggle('is-loss', profit < 0);
      }
    }

    const totalUnrealizedProfit = totalMarketValue - summary.totalCost;
    const totalUnrealizedProfitRate = summary.totalCost > 0 ? totalUnrealizedProfit / summary.totalCost : 0;
    const brokerStyleProfit = totalUnrealizedProfit + summary.activeRealizedProfit;
    const brokerStyleProfitRate = summary.totalCost > 0 ? brokerStyleProfit / summary.totalCost : 0;
    const totalProfit = totalUnrealizedProfit + summary.realizedProfit;
    const totalProfitRate = summary.totalBuyAmount > 0 ? totalProfit / summary.totalBuyAmount : 0;

    if (!hasAllQuotes) {
      setStatus(`部分行情未返回（${returnedQuoteCount}/${activePositions.length}），汇总收益未更新`);
      updateQuoteTime(quotes);
      return;
    }

    setText('[data-total-market-value]', currencyFormatter.format(totalMarketValue));
    setText('[data-total-unrealized-profit]', currencyFormatter.format(totalUnrealizedProfit));
    setText('[data-total-unrealized-profit-rate]', `收益率 ${percentFormatter.format(totalUnrealizedProfitRate)}`);
    setText('[data-broker-style-profit]', currencyFormatter.format(brokerStyleProfit));
    setText('[data-broker-style-profit-rate]', `收益率 ${percentFormatter.format(brokerStyleProfitRate)}`);
    setText('[data-total-profit]', currencyFormatter.format(totalProfit));
    setText('[data-total-profit-rate]', `累计收益率 ${percentFormatter.format(totalProfitRate)} · 按累计买入金额`);
    document.querySelector('[data-total-unrealized-profit]')?.classList.toggle('is-negative', totalUnrealizedProfit < 0);
    document.querySelector('[data-total-unrealized-profit]')?.classList.toggle('is-positive', totalUnrealizedProfit >= 0);
    document.querySelector('[data-broker-style-profit]')?.classList.toggle('is-negative', brokerStyleProfit < 0);
    document.querySelector('[data-broker-style-profit]')?.classList.toggle('is-positive', brokerStyleProfit >= 0);
    document.querySelector('[data-total-profit]')?.classList.toggle('is-negative', totalProfit < 0);
    document.querySelector('[data-total-profit]')?.classList.toggle('is-positive', totalProfit >= 0);

    setStatus('实时行情已更新');
    updateQuoteTime(quotes);
    mergeLiveQuotesIntoCalendar(quotes);
  }

  function setTargetCell(selector, code, value, state = '') {
    const element = document.querySelector(`${selector}[data-code="${code}"]`);
    if (!element) return;

    element.textContent = value;
    element.classList.toggle('is-positive', state === 'positive');
    element.classList.toggle('is-negative', state === 'negative');
  }

  function parseFundEstimatePayload(raw) {
    const match = raw.match(/^jsonpgz\((.*)\);?$/);
    if (!match) return null;

    try {
      return JSON.parse(match[1]);
    } catch {
      return null;
    }
  }

  async function loadFundEstimateByFetch(code) {
    const response = await fetch(`https://fundgz.1234567.com.cn/js/${code}.js?rt=${Date.now()}`);
    if (!response.ok) return null;
    return parseFundEstimatePayload(await response.text());
  }

  function loadFundEstimateByScript(code) {
    return new Promise((resolve) => {
      const previousJsonpgz = window.jsonpgz;
      const script = document.createElement('script');
      script.src = `https://fundgz.1234567.com.cn/js/${code}.js?rt=${Date.now()}`;
      script.async = true;

      window.jsonpgz = (payload) => {
        window.jsonpgz = previousJsonpgz;
        script.remove();
        resolve(payload);
      };

      script.onerror = () => {
        window.jsonpgz = previousJsonpgz;
        script.remove();
        resolve(null);
      };

      document.head.append(script);
    });
  }

  async function loadTargetMetrics() {
    try {
      const fields = ['f2', 'f12', 'f13', 'f14', 'f116', 'f124'].join(',');
      const url = `https://push2delay.eastmoney.com/api/qt/ulist.np/get?fltt=2&secids=${targetEastmoneySecids.join(',')}&fields=${fields}`;
      const response = await fetch(url);
      if (!response.ok) throw new Error(`Target ETF quote request failed: ${response.status}`);

      const payload = await response.json();
      const quotes = (payload.data?.diff ?? []).map(normalizeEastmoneyQuote).filter(Boolean);
      const quoteByCode = new Map(quotes.map((quote) => [quote.symbol.slice(2), quote]));

      for (const item of targetAllocations) {
        const quote = quoteByCode.get(item.code);
        if (quote?.scale > 0) {
          setTargetCell('[data-target-scale]', item.code, compactCurrencyFormatter.format(quote.scale));
        }

        let estimate = null;
        try {
          estimate = await loadFundEstimateByFetch(item.code);
        } catch {
          estimate = await loadFundEstimateByScript(item.code);
        }

        const estimatedNav = Number(estimate?.gsz || estimate?.dwjz);
        if (quote?.price > 0 && estimatedNav > 0) {
          const premium = quote.price / estimatedNav - 1;
          setTargetCell(
            '[data-target-premium]',
            item.code,
            percentFormatter.format(premium),
            premium >= 0 ? 'positive' : 'negative',
          );
        }
      }
    } catch (error) {
      console.warn(error);
    }
  }

  async function loadEastmoneyQuotes() {
    const fields = ['f2', 'f12', 'f13', 'f14', 'f18', 'f124'].join(',');
    const url = `https://push2delay.eastmoney.com/api/qt/ulist.np/get?fltt=2&secids=${eastmoneySecids.join(',')}&fields=${fields}`;
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 5000);

    try {
      const response = await fetch(url, { signal: controller.signal });
      if (!response.ok) throw new Error(`Eastmoney quote request failed: ${response.status}`);

      const payload = await response.json();
      const quotes = (payload.data?.diff ?? []).map(normalizeEastmoneyQuote).filter(Boolean);
      if (!quotes.length) throw new Error('Eastmoney quote response is empty');

      return quotes;
    } finally {
      clearTimeout(timeout);
    }
  }

  function loadTencentQuotes() {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = `https://qt.gtimg.cn/q=${tencentSymbols.join(',')}`;
      script.charset = 'gbk';
      script.async = true;

      script.onload = () => {
        const quotes = tencentSymbols.map(parseTencentQuote).filter(Boolean);
        if (!quotes.length) {
          reject(new Error('Tencent quote response is empty'));
          return;
        }
        resolve(quotes);
      };

      script.onerror = () => reject(new Error('Tencent quote script failed'));
      document.head.append(script);
    });
  }

  async function loadQuotes() {
    try {
      const quotes = await loadEastmoneyQuotes();
      renderHoldings(quotes);
      setStatus('实时行情已更新');
      return;
    } catch (eastmoneyError) {
      console.warn(eastmoneyError);
    }

    try {
      const quotes = await loadTencentQuotes();
      renderHoldings(quotes);
      setStatus('实时行情已更新（备用源）');
    } catch (tencentError) {
      console.warn(tencentError);
      setStatus('行情接口加载失败，已保留静态成本数据');
    }
  }

  loadQuotes();
  loadTargetMetrics();
  refreshDailyCalendar();
</script>
<script src="../../scripts/portfolio-gif.ts"></script>
</ProjectLayout>
