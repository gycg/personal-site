---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageSidebar from '../../components/PageSidebar.astro';
import {
  calculatePortfolioSummary,
  calculatePositions,
  getEastmoneySecid,
  getSecurityById,
  getQuoteSymbol,
  industryPlanAllocations,
  securities,
  targetAllocations,
  trades,
} from '../../data/holdings';

const positions = calculatePositions();
const summary = calculatePortfolioSummary();
const displayTrades = [...trades].sort((a, b) => b.executedAt.localeCompare(a.executedAt));
const chronologicalTrades = [...trades].sort((a, b) => a.executedAt.localeCompare(b.executedAt));
const eastmoneySecids = securities.map(getEastmoneySecid);
const tencentSymbols = securities.map(getQuoteSymbol);
const maxTradeAmount = Math.max(...trades.map((trade) => trade.amount + trade.fee), 1);
const firstTradeDate = chronologicalTrades[0]?.executedAt.slice(0, 10).replaceAll('-', '') ?? '20260416';
const targetTotalAmount = targetAllocations.reduce((sum, item) => sum + (item.amount ?? 0), 0);
const industryPlanTotals = industryPlanAllocations.reduce(
  (totals, item) => ({
    currentAmount: totals.currentAmount + item.currentAmount,
    newCashBuy: totals.newCashBuy + item.newCashBuy,
    switchedCashBuy: totals.switchedCashBuy + item.switchedCashBuy,
    finalAmount: totals.finalAmount + item.finalAmount,
  }),
  { currentAmount: 0, newCashBuy: 0, switchedCashBuy: 0, finalAmount: 0 },
);
const targetAllocationGroups = [...targetAllocations.reduce((groups, item) => {
  const group = groups.get(item.category) ?? {
    category: item.category,
    amount: 0,
    weight: 0,
    funds: [] as typeof targetAllocations,
  };

  group.amount += item.amount ?? 0;
  group.weight += item.weight ?? 0;
  group.funds.push(item);
  groups.set(item.category, group);
  return groups;
}, new Map<string, { category: string; amount: number; weight: number; funds: typeof targetAllocations }>()).values()];
const targetEastmoneySecids = targetAllocations.map((item) => `${item.market === 'sh' ? '1' : '0'}.${item.code}`);

type KlineGroup = {
  symbol: string;
  rows: Array<{
    date: string;
    close: number;
  }>;
};

type DailyPortfolioPoint = {
  date: string;
  marketValue: number;
  cost: number;
  profit: number;
  dailyChange: number;
  trades: typeof trades;
};

function getTradeDate(trade: (typeof trades)[number]) {
  return trade.executedAt.slice(0, 10);
}

function normalizeKlinePayload(payload: any): KlineGroup | null {
  const data = payload.data;
  if (!data?.klines?.length) return null;

  const symbol = `${Number(data.market) === 1 ? 'sh' : 'sz'}${data.code}`;
  const rows = data.klines
    .map((line: string) => {
      const parts = line.split(',');
      const close = Number(parts[2]);
      if (!parts[0] || !Number.isFinite(close)) return null;
      return { date: parts[0], close };
    })
    .filter(Boolean);

  return rows.length ? { symbol, rows } : null;
}

function normalizeTencentKlinePayload(payload: any, position: (typeof positions)[number]): KlineGroup | null {
  const symbol = getQuoteSymbol(position);
  const rows = payload.data?.[symbol]?.qfqday ?? payload.data?.[symbol]?.day ?? [];
  const normalizedRows = rows
    .map((row: string[]) => {
      const close = Number(row[2]);
      if (!row[0] || !Number.isFinite(close)) return null;
      return { date: row[0], close };
    })
    .filter(Boolean);

  return normalizedRows.length ? { symbol, rows: normalizedRows } : null;
}

async function fetchTencentKlineGroup(position: (typeof positions)[number]): Promise<KlineGroup | null> {
  const symbol = getQuoteSymbol(position);
  const start = chronologicalTrades[0]?.executedAt.slice(0, 10) ?? '2026-04-16';
  const url = `https://web.ifzq.gtimg.cn/appstock/app/fqkline/get?param=${symbol},day,${start},2050-01-01,1600,qfq`;

  for (let attempt = 0; attempt < 2; attempt += 1) {
    try {
      const response = await fetch(`${url}&_=${Date.now()}-${attempt}`);
      if (!response.ok) continue;

      const kline = normalizeTencentKlinePayload(await response.json(), position);
      if (kline) return kline;
    } catch {
      // Keep build resilient; Eastmoney remains the primary source.
    }
  }

  return null;
}

async function fetchKlineGroup(position: (typeof positions)[number]): Promise<KlineGroup | null> {
  const fields1 = 'f1,f2,f3,f4,f5,f6';
  const fields2 = 'f51,f52,f53,f54,f55,f56,f57,f58,f59,f60,f61';
  const secid = getEastmoneySecid(position);
  const url = `https://push2his.eastmoney.com/api/qt/stock/kline/get?secid=${secid}&fields1=${fields1}&fields2=${fields2}&klt=101&fqt=1&beg=${firstTradeDate}&end=20500101`;

  for (let attempt = 0; attempt < 3; attempt += 1) {
    try {
      const response = await fetch(`${url}&_=${Date.now()}-${attempt}`);
      if (!response.ok) continue;

      const kline = normalizeKlinePayload(await response.json());
      if (kline) return kline;
    } catch {
      // The upstream endpoint occasionally drops connections. Retry and keep build resilient.
    }
  }

  return fetchTencentKlineGroup(position);
}

function calculateDailyPortfolioPoints(klineGroups: KlineGroup[]): DailyPortfolioPoint[] {
  const klineBySymbol = new Map(klineGroups.map((group) => [group.symbol, group.rows]));
  const allDates = [...new Set(klineGroups.flatMap((group) => group.rows.map((row) => row.date)))].sort();
  const sortedTrades = [...trades].sort((a, b) => a.executedAt.localeCompare(b.executedAt));
  const stateById = new Map(positions.map((position) => [position.id, { quantity: 0, cost: 0, realizedProfit: 0 }]));
  const latestCloseBySymbol = new Map<string, number>();
  let tradeIndex = 0;
  let previousProfit: number | null = null;

  return allDates
    .map((date) => {
      for (const [symbol, rows] of klineBySymbol.entries()) {
        const row = rows.find((item) => item.date === date);
        if (row) latestCloseBySymbol.set(symbol, row.close);
      }

      while (tradeIndex < sortedTrades.length && getTradeDate(sortedTrades[tradeIndex]) <= date) {
        const trade = sortedTrades[tradeIndex];
        const state = stateById.get(trade.securityId);

        if (state) {
          if (trade.side === '买入') {
            state.quantity += trade.quantity;
            state.cost += trade.amount + trade.fee;
          } else {
            const averageCost = state.quantity > 0 ? state.cost / state.quantity : 0;
            const closingCost = averageCost * trade.quantity;
            state.quantity -= trade.quantity;
            state.cost -= closingCost;
            state.realizedProfit += trade.amount - trade.fee - closingCost;
          }
        }

        tradeIndex += 1;
      }

      let marketValue = 0;
      let cost = 0;
      let realizedProfit = 0;

      for (const position of positions) {
        const state = stateById.get(position.id);
        const close = latestCloseBySymbol.get(position.quoteSymbol);
        if (!state || !close) continue;

        marketValue += state.quantity * close;
        cost += state.cost;
        realizedProfit += state.realizedProfit;
      }

      if (marketValue <= 0 && cost <= 0) return null;

      const profit = marketValue - cost + realizedProfit;
      const dailyChange = previousProfit === null ? 0 : profit - previousProfit;
      previousProfit = profit;

      return { date, marketValue, cost, profit, dailyChange };
    })
    .filter(Boolean)
    .map((point) => ({
      ...point,
      trades: sortedTrades.filter((trade) => getTradeDate(trade) === point.date),
    }));
}

const dailyKlineResults = await Promise.allSettled(positions.map(fetchKlineGroup));
const dailyKlineGroups = dailyKlineResults
  .filter((result): result is PromiseFulfilledResult<KlineGroup> => result.status === 'fulfilled' && Boolean(result.value))
  .map((result) => result.value);
const dailyPortfolioPoints = calculateDailyPortfolioPoints(dailyKlineGroups);

const formatCurrency = new Intl.NumberFormat('zh-CN', {
  style: 'currency',
  currency: 'CNY',
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});

const formatNumber = new Intl.NumberFormat('zh-CN', {
  minimumFractionDigits: 0,
  maximumFractionDigits: 0,
});

const formatPrice = new Intl.NumberFormat('zh-CN', {
  minimumFractionDigits: 3,
  maximumFractionDigits: 3,
});

const formatPercent = new Intl.NumberFormat('zh-CN', {
  style: 'percent',
  minimumFractionDigits: 2,
  maximumFractionDigits: 2,
});
const weekdayLabels = ['一', '二', '三', '四', '五', '六', '日'];
const dailyPointByDate = new Map(dailyPortfolioPoints.map((point) => [point.date, point]));
const dailyCalendarMonths = (() => {
  if (!dailyPortfolioPoints.length) return [];

  const start = new Date(`${dailyPortfolioPoints[0].date}T00:00:00`);
  const end = new Date(`${dailyPortfolioPoints.at(-1)?.date}T00:00:00`);
  const months = [];
  const cursor = new Date(start.getFullYear(), start.getMonth(), 1);

  while (cursor <= end) {
    const year = cursor.getFullYear();
    const month = cursor.getMonth();
    const firstDay = new Date(year, month, 1);
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const leadingBlanks = (firstDay.getDay() + 6) % 7;
    const cells = [
      ...Array.from({ length: leadingBlanks }, (_, index) => ({ key: `blank-${year}-${month}-${index}`, isBlank: true as const })),
      ...Array.from({ length: daysInMonth }, (_, index) => {
        const day = index + 1;
        const date = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        return {
          key: date,
          isBlank: false as const,
          day,
          date,
          point: dailyPointByDate.get(date),
        };
      }),
    ];

    months.push({
      key: `${year}-${String(month + 1).padStart(2, '0')}`,
      label: `${year}年${month + 1}月`,
      cells,
    });
    cursor.setMonth(cursor.getMonth() + 1);
  }

  return months;
})();
const getDailyTradeSummary = (point: DailyPortfolioPoint) => {
  if (!point.trades.length) return '无交易';

  return point.trades
    .map((trade) => {
      const security = getSecurityById(trade.securityId);
      return `${trade.side}${security?.name ?? ''} ${formatNumber.format(trade.quantity)}份`;
    })
    .join(' / ');
};
const targetAllocationMarkdown = [
  '| 类别 | 场内基金 | 买入金额 | 占比 | 费率 |',
  '| --- | --- | ---: | ---: | --- |',
  ...targetAllocationGroups.map((group) => (
    `| ${group.category} | ${group.funds.map((fund) => `**${fund.code} ${fund.name}**`).join('<br>')} | ${formatCurrency.format(group.amount)} | ${formatPercent.format(group.weight)} | ${group.funds.map((fund) => fund.feeRate).join('<br>')} |`
  )),
  `| **合计** |  | ${formatCurrency.format(targetTotalAmount)} | ${formatPercent.format(1)} |  |`,
].join('\n');
const industryPlanMarkdown = [
  '| 类别 | 基金代码/名称 | 当前已有 | 操作 | 新增资金买入 | 最终持仓金额 | 最终占行业仓比例 |',
  '| --- | --- | ---: | --- | ---: | ---: | ---: |',
  ...industryPlanAllocations.map((item) => (
    `| ${item.category} | **${item.code} ${item.name}** | ${formatCurrency.format(item.currentAmount)} | ${item.action} | ${formatCurrency.format(item.newCashBuy)} | ${formatCurrency.format(item.finalAmount)} | ${formatPercent.format(item.finalWeight)} |`
  )),
].join('\n');
---

<BaseLayout title="我的持仓（模拟）" description="公开记录模拟持仓、交易明细、持仓成本和实时估算盈亏。" canonicalPath="/projects/holdings/">
  <div class="page-grid">
    <div>
      <section class="hero">
        <p class="eyebrow">项目</p>
        <h1>我的持仓（模拟）</h1>
        <p class="lead">
          用交易记录算出当前持仓成本，再尝试读取实时行情估算市值和浮动盈亏。数据用于复盘和公开记录，不构成投资建议。
        </p>
      </section>

      <section class="holding-summary" aria-label="持仓总览" data-holdings-root>
        <div class="holding-status">
          <span data-quote-status>正在获取实时行情...</span>
          <time data-quote-time datetime="">--</time>
        </div>

        <div class="holding-metric-grid">
          <article class="holding-metric">
            <span>持仓成本</span>
            <strong>{formatCurrency.format(summary.totalCost)}</strong>
            <p>含买入手续费</p>
          </article>
          <article class="holding-metric">
            <span>最新市值</span>
            <strong data-total-market-value>--</strong>
            <p>按实时价格估算</p>
          </article>
          <article class="holding-metric">
            <span>总浮盈</span>
            <strong data-total-profit>--</strong>
            <p data-total-profit-rate>收益率 --</p>
          </article>
          <article class="holding-metric">
            <span>累计手续费</span>
            <strong>{formatCurrency.format(summary.totalFees)}</strong>
            <p>{formatNumber.format(summary.totalQuantity)} 份持仓</p>
          </article>
        </div>
      </section>

      <section class="content-section" aria-labelledby="target-allocation-title">
        <div class="section-head">
          <div>
            <h2 id="target-allocation-title">目标投资结构</h2>
            <p>上方是 100 万基础目标组合，下方加入最终 20 万行业仓计划，用来对照后续买入和调仓进度。</p>
          </div>
          <button
            class="copy-table-button"
            type="button"
            data-copy-table
            data-copy-value={targetAllocationMarkdown}
            data-copy-success="已复制目标投资结构表格。"
            data-copy-status-id="target-allocation-copy-status"
          >
            复制表格
          </button>
        </div>

        <div class="target-allocation-panel">
          <div class="holding-table-wrap" data-scroll-hint="横向滑动查看完整目标配置">
            <table class="holding-table is-target">
              <thead>
                <tr>
                  <th>类别</th>
                  <th>场内基金</th>
                  <th>买入金额</th>
                  <th>占比</th>
                  <th>费率</th>
                  <th>实时规模</th>
                  <th>估算溢价率</th>
                </tr>
              </thead>
              <tbody>
                {targetAllocationGroups.map((group) => (
                  <tr>
                    <td><strong>{group.category}</strong></td>
                    <td class="target-fund-cell">
                      {group.funds.map((fund) => (
                        <span class="target-fund-item">
                          <strong>{fund.code}</strong>
                          <em>{fund.name}</em>
                        </span>
                      ))}
                    </td>
                    <td>{formatCurrency.format(group.amount)}</td>
                    <td>{formatPercent.format(group.weight)}</td>
                    <td class="target-stack-cell">
                      {group.funds.map((fund) => (
                        <span>{fund.feeRate}</span>
                      ))}
                    </td>
                    <td class="target-stack-cell">
                      {group.funds.map((fund) => (
                        <span data-target-scale data-code={fund.code}>--</span>
                      ))}
                    </td>
                    <td class="target-stack-cell">
                      {group.funds.map((fund) => (
                        <span data-target-premium data-code={fund.code}>--</span>
                      ))}
                    </td>
                  </tr>
                ))}
                <tr class="is-total">
                  <td><strong>合计</strong></td>
                  <td></td>
                  <td>{formatCurrency.format(targetTotalAmount)}</td>
                  <td>{formatPercent.format(1)}</td>
                  <td></td>
                  <td></td>
                  <td></td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="copy-table-status" id="target-allocation-copy-status" aria-live="polite"></p>
        </div>

        <div class="target-plan-block" id="industry-plan-title">
          <div class="section-head">
            <div>
              <h3>行业仓加仓计划</h3>
              <p>目标投资结构中行业仓最终为 {formatCurrency.format(industryPlanTotals.finalAmount)}；新增现金 {formatCurrency.format(industryPlanTotals.newCashBuy)}，现有人工智能 ETF 保留不加仓。</p>
            </div>
            <button
              class="copy-table-button"
              type="button"
              data-copy-table
              data-copy-value={industryPlanMarkdown}
              data-copy-success="已复制计划持仓表格。"
              data-copy-status-id="industry-plan-copy-status"
            >
              复制表格
            </button>
          </div>

          <div class="holding-table-wrap" data-scroll-hint="横向滑动查看完整计划">
            <table class="holding-table is-plan">
              <thead>
                <tr>
                  <th>类别</th>
                  <th>基金代码/名称</th>
                  <th>当前已有</th>
                  <th>操作</th>
                  <th>新增资金买入</th>
                  <th>最终持仓金额</th>
                  <th>最终占行业仓比例</th>
                </tr>
              </thead>
              <tbody>
                {industryPlanAllocations.map((item) => (
                  <tr class:list={[item.finalAmount === 0 && 'is-exit-plan']}>
                    <td><strong>{item.category}</strong></td>
                    <td>
                      <strong>{item.code}</strong>
                      <span>{item.name}</span>
                    </td>
                    <td>{formatCurrency.format(item.currentAmount)}</td>
                    <td>{item.action}</td>
                    <td>{formatCurrency.format(item.newCashBuy)}</td>
                    <td><strong>{formatCurrency.format(item.finalAmount)}</strong></td>
                    <td>{formatPercent.format(item.finalWeight)}</td>
                  </tr>
                ))}
                <tr class="is-total">
                  <td><strong>合计</strong></td>
                  <td></td>
                  <td>{formatCurrency.format(industryPlanTotals.currentAmount)}</td>
                  <td></td>
                  <td>{formatCurrency.format(industryPlanTotals.newCashBuy)}</td>
                  <td><strong>{formatCurrency.format(industryPlanTotals.finalAmount)}</strong></td>
                  <td>{formatPercent.format(1)}</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="copy-table-status" id="industry-plan-copy-status" aria-live="polite"></p>
        </div>
      </section>

      <section class="content-section" aria-labelledby="holding-chart-title">
        <div class="section-head">
          <h2 id="holding-chart-title">持仓图表</h2>
        </div>

        <div class="holding-visual-panel" aria-label="持仓图表">
          <div class="allocation-strip" aria-label="按成本占比展示持仓结构">
            {positions.map((position) => {
              const share = summary.totalCost > 0 ? (position.cost / summary.totalCost) * 100 : 0;
              return (
                <div
                  class="allocation-segment"
                  style={`--share: ${share}%;`}
                  title={`${position.name} ${formatPercent.format(share / 100)}`}
                >
                  <span>{position.name}</span>
                  <strong>{formatPercent.format(share / 100)}</strong>
                </div>
              );
            })}
          </div>

          <div class="position-chart-grid">
            {positions.map((position) => {
              const costShare = summary.totalCost > 0 ? position.cost / summary.totalCost : 0;
              return (
                <article class="position-visual-card" data-position-visual data-symbol={position.quoteSymbol}>
                  <div class="position-visual-head">
                    <div>
                      <p>{position.name}</p>
                      <span>{position.code} · {position.note}</span>
                    </div>
                    <strong>{formatPercent.format(costShare)}</strong>
                  </div>

                  <dl class="position-visual-stats">
                    <div>
                      <dt>成本</dt>
                      <dd>{formatCurrency.format(position.cost)}</dd>
                    </div>
                    <div>
                      <dt>份额</dt>
                      <dd>{formatNumber.format(position.quantity)}</dd>
                    </div>
                    <div>
                      <dt>成本价</dt>
                      <dd>{formatPrice.format(position.cost / position.quantity)}</dd>
                    </div>
                    <div>
                      <dt>现价</dt>
                      <dd data-chart-price>--</dd>
                    </div>
                    <div>
                      <dt>市值</dt>
                      <dd data-chart-market-value>--</dd>
                    </div>
                    <div>
                      <dt>浮盈</dt>
                      <dd data-chart-profit>--</dd>
                    </div>
                  </dl>
                </article>
              );
            })}
          </div>
        </div>
      </section>

      <section class="content-section" aria-labelledby="daily-calendar-title">
        <div class="section-head">
          <div>
            <h2 id="daily-calendar-title">每日持仓日历</h2>
            <p>每个交易日显示当日涨跌额；下方小字为截至当天的累计浮盈。</p>
          </div>
          <p class="holding-calendar-status" data-calendar-status>正在刷新最新日 K 数据...</p>
        </div>

        <div class="holding-calendar" aria-label="每日持仓涨跌日历" data-calendar-root>
          {dailyCalendarMonths.length ? (
            <>
              <div class="holding-calendar-toolbar">
                <button type="button" data-calendar-prev aria-label="上一个月">‹</button>
                <strong data-calendar-label>{dailyCalendarMonths.at(-1)?.label}</strong>
                <button type="button" data-calendar-next aria-label="下一个月">›</button>
              </div>
              <div class="holding-calendar-pages" aria-live="polite">
                {dailyCalendarMonths.map((month, index) => (
                  <article
                    class="holding-calendar-month"
                    data-calendar-month
                    data-calendar-label={month.label}
                    hidden={index !== dailyCalendarMonths.length - 1}
                  >
                    <h3>{month.label}</h3>
                    <div class="holding-calendar-weekdays" aria-hidden="true">
                      {weekdayLabels.map((label) => <span>{label}</span>)}
                    </div>
                    <div class="holding-calendar-grid">
                      {month.cells.map((cell) => cell.isBlank ? (
                        <div class="holding-calendar-day is-empty" aria-hidden="true"></div>
                      ) : (
                        <article
                          class:list={[
                            'holding-calendar-day',
                            !cell.point && 'is-muted',
                            cell.point && cell.point.dailyChange >= 0 ? 'is-profit' : '',
                            cell.point && cell.point.dailyChange < 0 ? 'is-loss' : '',
                            cell.point?.trades.length && 'has-trade',
                          ]}
                        >
                          <time datetime={cell.date}>{cell.day}</time>
                          {cell.point ? (
                            <>
                              <strong>{cell.point.dailyChange >= 0 ? '+' : ''}{formatCurrency.format(cell.point.dailyChange)}</strong>
                              <span>{formatCurrency.format(cell.point.profit)}</span>
                              <p>{getDailyTradeSummary(cell.point)}</p>
                            </>
                          ) : (
                            <span>--</span>
                          )}
                        </article>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            </>
          ) : (
            <p class="empty">正在获取最新日 K 数据...</p>
          )}
        </div>
      </section>

      <section class="content-section" aria-labelledby="trade-chart-title">
        <div class="section-head">
          <h2 id="trade-chart-title">交易时间线</h2>
        </div>

        <div class="trade-timeline" aria-label="买入卖出时间线">
          {chronologicalTrades.map((trade) => {
            const security = getSecurityById(trade.securityId);
            const tradeCost = trade.amount + trade.fee;
            const barWidth = (tradeCost / maxTradeAmount) * 100;
            return (
              <article class:list={['trade-event', trade.side === '买入' ? 'is-buy' : 'is-sell']}>
                <time>{trade.executedAt.slice(5, 16)}</time>
                <div class="trade-event-main">
                  <div class="trade-event-head">
                    <strong>{security?.name}</strong>
                    <span>{trade.side} {formatNumber.format(trade.quantity)} 份</span>
                  </div>
                  <div class="trade-event-bar">
                    <i style={`--bar: ${barWidth}%;`}></i>
                  </div>
                  <p>{formatPrice.format(trade.price)} · {formatCurrency.format(trade.amount)} · 手续费 {formatCurrency.format(trade.fee)}</p>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <section class="content-section" aria-labelledby="position-title">
        <div class="section-head">
          <h2 id="position-title">当前持仓</h2>
        </div>

        <div class="holding-table-wrap" data-scroll-hint="横向滑动查看完整持仓数据">
          <table class="holding-table">
            <thead>
              <tr>
                <th>标的</th>
                <th>代码</th>
                <th>持仓</th>
                <th>成本价</th>
                <th>持仓成本</th>
                <th>现价</th>
                <th>市值</th>
                <th>浮盈</th>
                <th>收益率</th>
              </tr>
            </thead>
            <tbody>
              {positions.map((position) => (
                <tr data-position-row data-symbol={position.quoteSymbol}>
                  <td>
                    <strong>{position.name}</strong>
                    <span>{position.note}</span>
                  </td>
                  <td>{position.code}</td>
                  <td>{formatNumber.format(position.quantity)}</td>
                  <td>{formatPrice.format(position.cost / position.quantity)}</td>
                  <td>{formatCurrency.format(position.cost)}</td>
                  <td data-current-price>--</td>
                  <td data-market-value>--</td>
                  <td data-profit>--</td>
                  <td data-profit-rate>--</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section class="content-section" aria-labelledby="trade-title">
        <div class="section-head">
          <h2 id="trade-title">交易记录</h2>
        </div>

        <div class="holding-table-wrap" data-scroll-hint="横向滑动查看完整交易记录">
          <table class="holding-table is-compact">
            <thead>
              <tr>
                <th>日期时间</th>
                <th>标的</th>
                <th>成交价</th>
                <th>成交量</th>
                <th>成交金额</th>
                <th>手续费</th>
                <th>方向</th>
              </tr>
            </thead>
            <tbody>
              {displayTrades.map((trade) => {
                const security = getSecurityById(trade.securityId);
                return (
                  <tr>
                    <td>{trade.executedAt}</td>
                    <td>
                      <strong>{security?.name}</strong>
                      <span>{security?.code}</span>
                    </td>
                    <td>{formatPrice.format(trade.price)}</td>
                    <td>{formatNumber.format(trade.quantity)}</td>
                    <td>{formatCurrency.format(trade.amount)}</td>
                    <td>{formatCurrency.format(trade.fee)}</td>
                    <td><span class:list={['trade-side', trade.side === '买入' ? 'is-buy' : 'is-sell']}>{trade.side}</span></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    </div>

    <PageSidebar
      title="持仓（模拟）"
      intro="实时行情来自公开行情脚本，可能有延迟或失败；模拟买卖记录仍以本页静态数据为准。"
      sections={[
        {
          title: '入口',
          items: [
            { label: '项目页', href: '/projects/' },
            { label: '行业仓加仓计划', href: '#industry-plan-title' },
            { label: '目标投资结构', href: '#target-allocation-title' },
            { label: '每日持仓日历', href: '#daily-calendar-title' },
            { label: '全部文章', href: '/posts/' },
            { label: '研究方法', href: '/about/#method' },
          ],
        },
      ]}
    />
  </div>

<script define:vars={{ positions, summary, trades, firstTradeDate, eastmoneySecids, tencentSymbols, targetAllocations, targetEastmoneySecids }}>
  const copyTableButtons = document.querySelectorAll('[data-copy-table]');
  const copyPlainText = async (value) => {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(value);
      return;
    }

    const input = document.createElement('textarea');
    input.value = value;
    input.setAttribute('readonly', '');
    input.style.position = 'fixed';
    input.style.opacity = '0';
    document.body.append(input);
    input.select();
    document.execCommand('copy');
    input.remove();
  };

  copyTableButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const copyTableStatus = button.dataset.copyStatusId
        ? document.getElementById(button.dataset.copyStatusId)
        : null;

      try {
        await copyPlainText(button.dataset.copyValue || '');
        if (copyTableStatus) copyTableStatus.textContent = button.dataset.copySuccess || '已复制表格。';
      } catch {
        if (copyTableStatus) copyTableStatus.textContent = '复制失败，可以手动选中表格内容。';
      }
    });
  });

  function initCalendarPager() {
    const calendarRoot = document.querySelector('[data-calendar-root]');
    if (!calendarRoot) return;

    const months = Array.from(calendarRoot.querySelectorAll('[data-calendar-month]'));
    const label = calendarRoot.querySelector('[data-calendar-label]');
    const previous = calendarRoot.querySelector('[data-calendar-prev]');
    const next = calendarRoot.querySelector('[data-calendar-next]');
    if (!months.length || !label || !previous || !next) return;

    let current = months.findIndex((month) => !month.hidden);
    if (current < 0) current = Math.max(months.length - 1, 0);

    const renderCalendarMonth = () => {
      months.forEach((month, index) => {
        month.hidden = index !== current;
      });
      if (label) label.textContent = months[current]?.dataset.calendarLabel ?? '';
      if (previous) previous.disabled = current <= 0;
      if (next) next.disabled = current >= months.length - 1;
    };

    previous?.addEventListener('click', () => {
      current = Math.max(current - 1, 0);
      renderCalendarMonth();
    });
    next?.addEventListener('click', () => {
      current = Math.min(current + 1, months.length - 1);
      renderCalendarMonth();
    });
    renderCalendarMonth();
  }

  initCalendarPager();

  const currencyFormatter = new Intl.NumberFormat('zh-CN', {
    style: 'currency',
    currency: 'CNY',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
  const priceFormatter = new Intl.NumberFormat('zh-CN', {
    minimumFractionDigits: 3,
    maximumFractionDigits: 3,
  });
  const percentFormatter = new Intl.NumberFormat('zh-CN', {
    style: 'percent',
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
  const compactCurrencyFormatter = new Intl.NumberFormat('zh-CN', {
    style: 'currency',
    currency: 'CNY',
    notation: 'compact',
    maximumFractionDigits: 2,
  });
  const weekdayLabels = ['一', '二', '三', '四', '五', '六', '日'];

  function getTradeDate(trade) {
    return trade.executedAt.slice(0, 10);
  }

  function normalizeBrowserKlinePayload(payload) {
    const data = payload.data;
    if (!data?.klines?.length) return null;

    const symbol = `${Number(data.market) === 1 ? 'sh' : 'sz'}${data.code}`;
    const rows = data.klines
      .map((line) => {
        const parts = line.split(',');
        const close = Number(parts[2]);
        return parts[0] && Number.isFinite(close) ? { date: parts[0], close } : null;
      })
      .filter(Boolean);

    return rows.length ? { symbol, rows } : null;
  }

  function normalizeBrowserTencentKlinePayload(payload, position) {
    const rows = payload.data?.[position.quoteSymbol]?.qfqday ?? payload.data?.[position.quoteSymbol]?.day ?? [];
    const normalizedRows = rows
      .map((row) => {
        const close = Number(row[2]);
        return row[0] && Number.isFinite(close) ? { date: row[0], close } : null;
      })
      .filter(Boolean);

    return normalizedRows.length ? { symbol: position.quoteSymbol, rows: normalizedRows } : null;
  }

  async function loadBrowserKlineGroup(position) {
    const marketPrefix = position.market === 'sh' ? '1' : '0';
    const fields1 = 'f1,f2,f3,f4,f5,f6';
    const fields2 = 'f51,f52,f53,f54,f55,f56,f57,f58,f59,f60,f61';
    const url = `https://push2his.eastmoney.com/api/qt/stock/kline/get?secid=${marketPrefix}.${position.code}&fields1=${fields1}&fields2=${fields2}&klt=101&fqt=1&beg=${firstTradeDate}&end=20500101`;

    try {
      const response = await fetch(`${url}&_=${Date.now()}`, { cache: 'no-store' });
      if (response.ok) {
        const kline = normalizeBrowserKlinePayload(await response.json());
        if (kline) return kline;
      }
    } catch (error) {
      console.warn(`Eastmoney kline failed for ${position.code}`, error);
    }

    try {
      const start = getTradeDate([...trades].sort((a, b) => a.executedAt.localeCompare(b.executedAt))[0]);
      const tencentUrl = `https://web.ifzq.gtimg.cn/appstock/app/fqkline/get?param=${position.quoteSymbol},day,${start},2050-01-01,1600,qfq`;
      const response = await fetch(`${tencentUrl}&_=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) return null;
      return normalizeBrowserTencentKlinePayload(await response.json(), position);
    } catch (error) {
      console.warn(`Tencent kline failed for ${position.code}`, error);
      return null;
    }
  }

  function calculateBrowserDailyPoints(klineGroups) {
    const klineBySymbol = new Map(klineGroups.map((group) => [group.symbol, group.rows]));
    const allDates = [...new Set(klineGroups.flatMap((group) => group.rows.map((row) => row.date)))].sort();
    const sortedTrades = [...trades].sort((a, b) => a.executedAt.localeCompare(b.executedAt));
    const stateById = new Map(positions.map((position) => [position.id, { quantity: 0, cost: 0, realizedProfit: 0 }]));
    const latestCloseBySymbol = new Map();
    let tradeIndex = 0;
    let previousProfit = null;

    return allDates.map((date) => {
      for (const [symbol, rows] of klineBySymbol.entries()) {
        const row = rows.find((item) => item.date === date);
        if (row) latestCloseBySymbol.set(symbol, row.close);
      }

      while (tradeIndex < sortedTrades.length && getTradeDate(sortedTrades[tradeIndex]) <= date) {
        const trade = sortedTrades[tradeIndex];
        const state = stateById.get(trade.securityId);

        if (state) {
          if (trade.side === '买入') {
            state.quantity += trade.quantity;
            state.cost += trade.amount + trade.fee;
          } else {
            const averageCost = state.quantity > 0 ? state.cost / state.quantity : 0;
            const closingCost = averageCost * trade.quantity;
            state.quantity -= trade.quantity;
            state.cost -= closingCost;
            state.realizedProfit += trade.amount - trade.fee - closingCost;
          }
        }

        tradeIndex += 1;
      }

      let marketValue = 0;
      let cost = 0;
      let realizedProfit = 0;

      for (const position of positions) {
        const state = stateById.get(position.id);
        const close = latestCloseBySymbol.get(position.quoteSymbol);
        if (!state || !close) continue;

        marketValue += state.quantity * close;
        cost += state.cost;
        realizedProfit += state.realizedProfit;
      }

      if (marketValue <= 0 && cost <= 0) return null;

      const profit = marketValue - cost + realizedProfit;
      const dailyChange = previousProfit === null ? 0 : profit - previousProfit;
      previousProfit = profit;

      return {
        date,
        profit,
        dailyChange,
        trades: sortedTrades.filter((trade) => getTradeDate(trade) === date),
      };
    }).filter(Boolean);
  }

  function getBrowserDailyTradeSummary(point) {
    if (!point.trades.length) return '无交易';

    return point.trades
      .map((trade) => {
        const position = positions.find((item) => item.id === trade.securityId);
        return `${trade.side}${position?.name ?? ''} ${trade.quantity.toLocaleString('zh-CN')}份`;
      })
      .join(' / ');
  }

  function createCalendarDay(cell) {
    const article = document.createElement('article');
    article.className = 'holding-calendar-day';

    if (!cell.point) article.classList.add('is-muted');
    if (cell.point?.dailyChange >= 0) article.classList.add('is-profit');
    if (cell.point?.dailyChange < 0) article.classList.add('is-loss');
    if (cell.point?.trades.length) article.classList.add('has-trade');

    const time = document.createElement('time');
    time.dateTime = cell.date;
    time.textContent = String(cell.day);
    article.append(time);

    if (!cell.point) {
      const empty = document.createElement('span');
      empty.textContent = '--';
      article.append(empty);
      return article;
    }

    const change = document.createElement('strong');
    change.textContent = `${cell.point.dailyChange >= 0 ? '+' : ''}${currencyFormatter.format(cell.point.dailyChange)}`;
    article.append(change);

    const profit = document.createElement('span');
    profit.textContent = currencyFormatter.format(cell.point.profit);
    article.append(profit);

    const tradesLabel = document.createElement('p');
    tradesLabel.textContent = getBrowserDailyTradeSummary(cell.point);
    article.append(tradesLabel);

    return article;
  }

  function renderBrowserCalendar(points) {
    const calendarRoot = document.querySelector('[data-calendar-root]');
    if (!calendarRoot || !points.length) return;

    const pointByDate = new Map(points.map((point) => [point.date, point]));
    const start = new Date(`${points[0].date}T00:00:00`);
    const end = new Date(`${points.at(-1).date}T00:00:00`);
    const months = [];
    const cursor = new Date(start.getFullYear(), start.getMonth(), 1);

    while (cursor <= end) {
      const year = cursor.getFullYear();
      const month = cursor.getMonth();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const leadingBlanks = (new Date(year, month, 1).getDay() + 6) % 7;
      const cells = [
        ...Array.from({ length: leadingBlanks }, () => ({ isBlank: true })),
        ...Array.from({ length: daysInMonth }, (_, index) => {
          const day = index + 1;
          const date = `${year}-${String(month + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
          return { day, date, point: pointByDate.get(date), isBlank: false };
        }),
      ];

      months.push({ label: `${year}年${month + 1}月`, cells });
      cursor.setMonth(cursor.getMonth() + 1);
    }

    calendarRoot.replaceChildren();
    const toolbar = document.createElement('div');
    toolbar.className = 'holding-calendar-toolbar';
    toolbar.innerHTML = '<button type="button" data-calendar-prev aria-label="上一个月">‹</button><strong data-calendar-label></strong><button type="button" data-calendar-next aria-label="下一个月">›</button>';
    calendarRoot.append(toolbar);

    const pages = document.createElement('div');
    pages.className = 'holding-calendar-pages';
    pages.setAttribute('aria-live', 'polite');

    months.forEach((month, index) => {
      const monthElement = document.createElement('article');
      monthElement.className = 'holding-calendar-month';
      monthElement.dataset.calendarMonth = '';
      monthElement.dataset.calendarLabel = month.label;
      monthElement.hidden = index !== months.length - 1;

      const heading = document.createElement('h3');
      heading.textContent = month.label;
      monthElement.append(heading);

      const weekdays = document.createElement('div');
      weekdays.className = 'holding-calendar-weekdays';
      weekdays.setAttribute('aria-hidden', 'true');
      weekdayLabels.forEach((label) => {
        const span = document.createElement('span');
        span.textContent = label;
        weekdays.append(span);
      });
      monthElement.append(weekdays);

      const grid = document.createElement('div');
      grid.className = 'holding-calendar-grid';
      month.cells.forEach((cell) => {
        if (cell.isBlank) {
          const blank = document.createElement('div');
          blank.className = 'holding-calendar-day is-empty';
          blank.setAttribute('aria-hidden', 'true');
          grid.append(blank);
          return;
        }
        grid.append(createCalendarDay(cell));
      });
      monthElement.append(grid);
      pages.append(monthElement);
    });

    calendarRoot.append(pages);
    initCalendarPager();
  }

  async function refreshDailyCalendar() {
    const status = document.querySelector('[data-calendar-status]');

    try {
      const groups = (await Promise.all(positions.map(loadBrowserKlineGroup))).filter(Boolean);
      if (!groups.length) throw new Error('No browser kline data returned');

      const points = calculateBrowserDailyPoints(groups);
      if (!points.length) throw new Error('No daily portfolio points calculated');

      renderBrowserCalendar(points);
      if (status) status.textContent = `已刷新至 ${points.at(-1).date}`;
    } catch (error) {
      console.warn(error);
      if (status) status.textContent = '实时刷新失败，当前展示构建时快照';
    }
  }

  function setText(selector, value) {
    const element = document.querySelector(selector);
    if (element) element.textContent = value;
  }

  function setStatus(message) {
    setText('[data-quote-status]', message);
  }

  function updateQuoteTime(quotes) {
    const timeElement = document.querySelector('[data-quote-time]');
    if (!timeElement) return;

    const latest = quotes.map((quote) => quote.updatedAt).filter(Boolean).sort().at(-1);
    if (!latest) {
      timeElement.textContent = '行情时间 --';
      return;
    }

    timeElement.textContent = `行情时间 ${latest}`;
    timeElement.setAttribute('datetime', latest.replace(' ', 'T'));
  }

  function formatEastmoneyTime(timestamp) {
    if (!Number.isFinite(timestamp) || timestamp <= 0) return '';

    const date = new Date(timestamp * 1000);
    const pad = (value) => String(value).padStart(2, '0');
    return [
      date.getFullYear(),
      pad(date.getMonth() + 1),
      pad(date.getDate()),
    ].join('-') + ' ' + [
      pad(date.getHours()),
      pad(date.getMinutes()),
      pad(date.getSeconds()),
    ].join(':');
  }

  function normalizeEastmoneyQuote(item) {
    const price = Number(item.f2);
    if (!Number.isFinite(price) || price <= 0) return null;

    const market = String(item.f13) === '1' ? 'sh' : 'sz';
    return {
      symbol: `${market}${item.f12}`,
      name: item.f14,
      price,
      previousClose: Number(item.f18),
      scale: Number(item.f116),
      updatedAt: formatEastmoneyTime(Number(item.f124)),
    };
  }

  function parseTencentQuote(symbol) {
    const raw = window[`v_${symbol}`];
    if (!raw) return null;

    const parts = raw.split('~');
    const price = Number(parts[3]);
    if (!Number.isFinite(price) || price <= 0) return null;

    const timeRaw = parts[30] ?? '';
    const updatedAt = /^\d{14}$/.test(timeRaw)
      ? `${timeRaw.slice(0, 4)}-${timeRaw.slice(4, 6)}-${timeRaw.slice(6, 8)} ${timeRaw.slice(8, 10)}:${timeRaw.slice(10, 12)}:${timeRaw.slice(12, 14)}`
      : '';

    return {
      symbol,
      name: parts[1],
      price,
      previousClose: Number(parts[4]),
      updatedAt,
    };
  }

  function renderHoldings(quotes) {
    const quoteBySymbol = new Map(quotes.map((quote) => [quote.symbol, quote]));
    let totalMarketValue = 0;
    let hasAllQuotes = true;

    for (const position of positions) {
      const row = document.querySelector(`[data-position-row][data-symbol="${position.quoteSymbol}"]`);
      if (!row) continue;

      const quote = quoteBySymbol.get(position.quoteSymbol);
      if (!quote) {
        hasAllQuotes = false;
        continue;
      }

      const marketValue = quote.price * position.quantity;
      const profit = marketValue - position.cost + position.realizedProfit;
      const profitRate = position.cost > 0 ? profit / position.cost : 0;
      totalMarketValue += marketValue;

      row.querySelector('[data-current-price]').textContent = priceFormatter.format(quote.price);
      row.querySelector('[data-market-value]').textContent = currencyFormatter.format(marketValue);
      row.querySelector('[data-profit]').textContent = currencyFormatter.format(profit);
      row.querySelector('[data-profit-rate]').textContent = percentFormatter.format(profitRate);
      row.classList.toggle('is-profit', profit >= 0);
      row.classList.toggle('is-loss', profit < 0);

      const visualCard = document.querySelector(`[data-position-visual][data-symbol="${position.quoteSymbol}"]`);
      if (visualCard) {
        visualCard.querySelector('[data-chart-price]').textContent = priceFormatter.format(quote.price);
        visualCard.querySelector('[data-chart-market-value]').textContent = currencyFormatter.format(marketValue);
        visualCard.querySelector('[data-chart-profit]').textContent = currencyFormatter.format(profit);
        visualCard.classList.toggle('is-profit', profit >= 0);
        visualCard.classList.toggle('is-loss', profit < 0);
      }
    }

    const totalProfit = totalMarketValue - summary.totalCost + summary.realizedProfit;
    const totalProfitRate = summary.totalCost > 0 ? totalProfit / summary.totalCost : 0;

    setText('[data-total-market-value]', currencyFormatter.format(totalMarketValue));
    setText('[data-total-profit]', currencyFormatter.format(totalProfit));
    setText('[data-total-profit-rate]', `收益率 ${percentFormatter.format(totalProfitRate)}`);
    document.querySelector('[data-total-profit]')?.classList.toggle('is-negative', totalProfit < 0);
    document.querySelector('[data-total-profit]')?.classList.toggle('is-positive', totalProfit >= 0);

    setStatus(hasAllQuotes ? '实时行情已更新' : '部分行情未返回');
    updateQuoteTime(quotes);
  }

  function setTargetCell(selector, code, value, state = '') {
    const element = document.querySelector(`${selector}[data-code="${code}"]`);
    if (!element) return;

    element.textContent = value;
    element.classList.toggle('is-positive', state === 'positive');
    element.classList.toggle('is-negative', state === 'negative');
  }

  function parseFundEstimatePayload(raw) {
    const match = raw.match(/^jsonpgz\((.*)\);?$/);
    if (!match) return null;

    try {
      return JSON.parse(match[1]);
    } catch {
      return null;
    }
  }

  async function loadFundEstimateByFetch(code) {
    const response = await fetch(`https://fundgz.1234567.com.cn/js/${code}.js?rt=${Date.now()}`);
    if (!response.ok) return null;
    return parseFundEstimatePayload(await response.text());
  }

  function loadFundEstimateByScript(code) {
    return new Promise((resolve) => {
      const previousJsonpgz = window.jsonpgz;
      const script = document.createElement('script');
      script.src = `https://fundgz.1234567.com.cn/js/${code}.js?rt=${Date.now()}`;
      script.async = true;

      window.jsonpgz = (payload) => {
        window.jsonpgz = previousJsonpgz;
        script.remove();
        resolve(payload);
      };

      script.onerror = () => {
        window.jsonpgz = previousJsonpgz;
        script.remove();
        resolve(null);
      };

      document.head.append(script);
    });
  }

  async function loadTargetMetrics() {
    try {
      const fields = ['f2', 'f12', 'f13', 'f14', 'f116', 'f124'].join(',');
      const url = `https://push2delay.eastmoney.com/api/qt/ulist.np/get?fltt=2&secids=${targetEastmoneySecids.join(',')}&fields=${fields}`;
      const response = await fetch(url);
      if (!response.ok) throw new Error(`Target ETF quote request failed: ${response.status}`);

      const payload = await response.json();
      const quotes = (payload.data?.diff ?? []).map(normalizeEastmoneyQuote).filter(Boolean);
      const quoteByCode = new Map(quotes.map((quote) => [quote.symbol.slice(2), quote]));

      for (const item of targetAllocations) {
        const quote = quoteByCode.get(item.code);
        if (quote?.scale > 0) {
          setTargetCell('[data-target-scale]', item.code, compactCurrencyFormatter.format(quote.scale));
        }

        let estimate = null;
        try {
          estimate = await loadFundEstimateByFetch(item.code);
        } catch {
          estimate = await loadFundEstimateByScript(item.code);
        }

        const estimatedNav = Number(estimate?.gsz || estimate?.dwjz);
        if (quote?.price > 0 && estimatedNav > 0) {
          const premium = quote.price / estimatedNav - 1;
          setTargetCell(
            '[data-target-premium]',
            item.code,
            percentFormatter.format(premium),
            premium >= 0 ? 'positive' : 'negative',
          );
        }
      }
    } catch (error) {
      console.warn(error);
    }
  }

  async function loadEastmoneyQuotes() {
    const fields = ['f2', 'f12', 'f13', 'f14', 'f18', 'f124'].join(',');
    const url = `https://push2delay.eastmoney.com/api/qt/ulist.np/get?fltt=2&secids=${eastmoneySecids.join(',')}&fields=${fields}`;

    const response = await fetch(url);
    if (!response.ok) throw new Error(`Eastmoney quote request failed: ${response.status}`);

    const payload = await response.json();
    const quotes = (payload.data?.diff ?? []).map(normalizeEastmoneyQuote).filter(Boolean);
    if (!quotes.length) throw new Error('Eastmoney quote response is empty');

    return quotes;
  }

  function loadTencentQuotes() {
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.src = `https://qt.gtimg.cn/q=${tencentSymbols.join(',')}`;
      script.charset = 'gbk';
      script.async = true;

      script.onload = () => {
        const quotes = tencentSymbols.map(parseTencentQuote).filter(Boolean);
        if (!quotes.length) {
          reject(new Error('Tencent quote response is empty'));
          return;
        }
        resolve(quotes);
      };

      script.onerror = () => reject(new Error('Tencent quote script failed'));
      document.head.append(script);
    });
  }

  async function loadQuotes() {
    try {
      const quotes = await loadEastmoneyQuotes();
      renderHoldings(quotes);
      setStatus('实时行情已更新');
      return;
    } catch (eastmoneyError) {
      console.warn(eastmoneyError);
    }

    try {
      const quotes = await loadTencentQuotes();
      renderHoldings(quotes);
      setStatus('实时行情已更新（备用源）');
    } catch (tencentError) {
      console.warn(tencentError);
      setStatus('行情接口加载失败，已保留静态成本数据');
    }
  }

  loadQuotes();
  loadTargetMetrics();
  refreshDailyCalendar();
</script>
</BaseLayout>
